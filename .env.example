# Supabase project settings → API. The anon key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of this app, used in confirmation and password-reset email links.
# Add <NEXT_PUBLIC_SITE_URL>/auth/callback to Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123
