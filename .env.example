# Supabase project settings → API. The anon key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Public URL of this app, used in confirmation and password-reset email links.
# Add <NEXT_PUBLIC_SITE_URL>/auth/callback to Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Stripe Connect OAuth. Keep all values below server-only.
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_CLIENT_SECRET=
STRIPE_CONNECT_REDIRECT_URI=http://127.0.0.1:43123/api/stripe/callback
# Generate with: openssl rand -base64 32
STRIPE_TOKEN_ENCRYPTION_KEY=
# Financial Connections. STRIPE_SECRET_KEY falls back to STRIPE_CONNECT_CLIENT_SECRET when unset.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional. Verifies financial_connections.account.refreshed_* events at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Required by the server to store encrypted Stripe tokens securely.
SUPABASE_SERVICE_ROLE_KEY=
# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123
NEXT_PUBLIC_APP_NAME=nest
DEMO_MODE=true

# Database (pledges, users, auctions — replace localStorage)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nest_invest?sslmode=require

# Auth / session (phone as identity)
# Example: Clerk, or NextAuth + Africa's Talking OTP
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# or
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:43123

# Safaricom Daraja (STK Push) — sandbox first
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR-PUBLIC-HOST/api/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional: name shown on the STK sheet
MPESA_ACCOUNT_REFERENCE=nest Bills

# Maturity / refunds later (B2C) — not needed for Phase 1 pledges
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://YOUR-PUBLIC-HOST/api/mpesa/b2c-result
MPESA_B2C_TIMEOUT_URL=https://YOUR-PUBLIC-HOST/api/mpesa/b2c-timeout

# SMS alerts (Africa's Talking is the usual KE path)
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=NEST

# Auction data — there is no public CBK/DhowCSD retail API
# Demo: you (or an admin) publish weekly results
AUCTION_ADMIN_TOKEN=

# Optional: scrape/manual snapshot of CBK results (not official API)
CBK_RESULTS_FEED_URL=

# DhowCSD / CDSC — only if a licensed participant gives you credentials
DHOW_CSD_BASE_URL=
DHOW_CSD_CLIENT_ID=
DHOW_CSD_CLIENT_SECRET=
DHOW_CSD_PARTICIPANT_CODE=

# nest economics (already hardcoded as 1% of interest in the app)
NEST_FEE_OF_INTEREST=0.01
MIN_PLEDGE_KES=100

# Hosting
# Vercel will inject this; set if you self-host
# VERCEL_URL=
